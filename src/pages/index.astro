---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { formatDate } from '../utils/formatDate';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="הבלוג שלי">
  <header class="hero">
    <span class="badge">{posts.length} פוסטים</span>
    <h1>הבלוג שלי</h1>
    <p>אוסף פוסטים קצרים על כל מיני נושאים.</p>
  </header>

  <ul class="grid">
    {
      posts.map((post) => (
        <li>
          <a class="card" href={`/posts/${post.id}/`}>
            <div class="card-meta">
              <span class="avatar">{post.data.author.charAt(0)}</span>
              <span>{post.data.author}</span>
              <span class="dot">·</span>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="read-more">
              לקריאה <span class="arrow">←</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .hero {
    padding-block: 4.5rem 2.5rem;
  }
  .badge {
    display: inline-block;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 500;
    font-size: 0.85rem;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
  }
  .hero h1 {
    margin: 0.75rem 0 0.25rem;
    font-size: clamp(2.2rem, 6vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .hero p {
    margin: 0;
    color: var(--muted);
    font-size: 1.15rem;
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .grid li:first-child {
    grid-column: 1 / -1;
  }
  .grid li:first-child h2 {
    font-size: 1.75rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
    border-color: var(--accent);
    outline: none;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .card h2 {
    margin: 0.9rem 0 0.4rem;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .card p {
    margin: 0 0 1.25rem;
    color: var(--muted);
    flex: 1;
  }
  .read-more {
    color: var(--accent);
    font-weight: 500;
  }
  .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .card:hover .arrow {
    transform: translateX(-4px);
  }
</style>
