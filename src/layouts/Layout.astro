---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="container">
      <slot />
      <footer>נבנה עם Astro</footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f5f6fa;
    --card: #ffffff;
    --text: #14161f;
    --muted: #6b7080;
    --accent: #5b5bf0;
    --accent-soft: #ececfe;
    --border: #e6e8ef;
    --shadow: 0 1px 2px rgb(20 22 31 / 0.04), 0 8px 24px rgb(20 22 31 / 0.06);
    --shadow-hover: 0 2px 4px rgb(20 22 31 / 0.06), 0 16px 40px rgb(91 91 240 / 0.14);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0e0f14;
      --card: #171922;
      --text: #eceef4;
      --muted: #9197a8;
      --accent: #8b8bff;
      --accent-soft: #23244a;
      --border: #262937;
      --shadow: 0 1px 2px rgb(0 0 0 / 0.3);
      --shadow-hover: 0 16px 40px rgb(0 0 0 / 0.45);
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: 'Heebo', system-ui, 'Segoe UI', Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--accent); }
  .container {
    max-width: 820px;
    margin: 0 auto;
    padding-inline: 1.25rem;
  }
  footer {
    color: var(--muted);
    text-align: center;
    font-size: 0.9rem;
    padding-block: 3rem;
  }
</style>
